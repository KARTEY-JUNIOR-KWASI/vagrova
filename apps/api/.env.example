# Vagrova API Configuration
PORT=4000
NODE_ENV=development

# Database (PostgreSQL with PostGIS via docker-compose.yml)
DATABASE_URL="postgresql://vagrova:vagrova_dev_password@localhost:5432/vagrova?schema=public"

# Redis (Caching & Atomic Job Offer Locks)
REDIS_URL="redis://localhost:6379"

# Security & Authentication
JWT_SECRET="vagrova_dev_super_secret_jwt_key_2026_change_in_prod"
JWT_EXPIRES_IN="7d"

# S3 / MinIO Object Storage (Photos, Proofs, Documents, Voice Notes)
STORAGE_DRIVER="local" # "s3" or "local"
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_BUCKET="vagrova-uploads"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadmin"
STORAGE_REGION="us-east-1"

# SMS & WhatsApp Gateway ("smsonline" | "mock")
SMS_PROVIDER="mock"
SMS_API_KEY="mock_key"
SMS_SENDER_ID="VAGROVA"

# Payment Gateways (Paystack / Hubtel Ghana Mobile Money & Cards)
PAYMENT_GATEWAY="mock" # "paystack" | "hubtel" | "mock"
PAYSTACK_SECRET_KEY="sk_test_xxx"
HUBTEL_CLIENT_ID="xxx"
HUBTEL_CLIENT_SECRET="xxx"
HUBTEL_MERCHANT_ACCOUNT_NUMBER="xxx"

